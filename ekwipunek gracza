    print("3 - pokaz EQ")
    print("4 - wyjdz do menu")

    wybor = int(input("daj wybor: "))

    if wybor == 1:
      if ekwipunek["zloto"] < 30:
        print()
        print("nie masz zlota na miecz")
        print()
      else:
        ekwipunek.update({"zloto": ekwipunek["zloto"] - 30})
        ekwipunek.update({"miecz": ekwipunek["miecz"] + 1})
